{
    "name": "chronos-monitor/laravel",
    "description": "Laravel integration for ChronosMonitor: report scheduled command status automatically, no changes to your command code.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "ChronosMonitor\\Laravel\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ChronosMonitor\\Laravel\\ChronosServiceProvider"
            ],
            "aliases": {
                "Chronos": "ChronosMonitor\\Laravel\\Facades\\Chronos"
            }
        }
    },
    "minimum-stability": "stable"
}
